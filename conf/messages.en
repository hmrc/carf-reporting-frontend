uploadXml.title = Upload an XML file
uploadXml.heading = Upload an XML file
uploadXml.hint = The selected file must be 250MB or less.
uploadXml.paragraph = We’ll automatically check the formatting of the file and send you to another page once completed.
uploadXml.error.file.select = Select a file
uploadXml.error.file.name.length = File name must be 100 characters or less and match the MessageRefId in the file
uploadXml.error.file.name.disallowed.characters = File name can only include letters a to z, numbers 0 to 9, underscore (_), hyphens and full stops
uploadXml.error.file.size.large = The selected file must be 250MB or less
uploadXml.error.file.content.virus = The selected file contains a virus
uploadXml.error.file.type.invalid = The selected file must be an XML
uploadXml.error.file.content.empty = The selected file is empty
uploadXml.error.file.content.unknown = The selected file could not be uploaded
uploadXml.processing = We are checking your file

invalidXml.title = There is a problem with the formatting of your file
invalidXml.heading = There is a problem with the formatting of your file
invalidXml.p1 = We cannot accept the file {0} because there is a problem with its formatting.
invalidXml.p2 = Check that all:
invalidXml.bullet.1 = element names are correct
invalidXml.bullet.2 = elements have an opening and a closing tag
invalidXml.bullet.3 = tags are correctly nested
invalidXml.p3 = The file must also have a CARF_OECD element with an XML namespace (xmlns) of
invalidXml.p3.namespaceCode = "urn:oecd:ties:carf:v1"
invalidXml.p4 = To make sure your XML file is formatted correctly, refer to the
invalidXml.p4.linkText = technical guidance for XML files
invalidXml.p5.linkText = Print this page
invalidXml.p6.linkText = Upload a different file

dataErrors.title = There is a problem with your file data
dataErrors.heading = There is a problem with your file data
dataErrors.p1 = We cannot accept the file {0} because it does not meet the data requirements.
dataErrors.h2 = What you can do next
dataErrors.list.1.linkText = Print this page
dataErrors.list.2 = View the errors on this page.
dataErrors.list.3.linkText = Refer to the technical guidance for XML files
dataErrors.list.3.after = and update your file.
dataErrors.list.4.linkText = Upload the updated file
dataErrors.hundredPara = Your file has over 100 errors. We only show the first 100 errors on this page.
dataErrors.table.caption = Errors
dataErrors.table.head.line = Line
dataErrors.table.head.error = Error

rcaspNotMatching.title = There is a problem with the RCASP ID in your file
rcaspNotMatching.heading = There is a problem with the RCASP ID in your file
rcaspNotMatching.p1 = The RCASP ID in your file is {0}.
rcaspNotMatching.p2 = This does not match any of the reporting cryptoasset service providers (RCASPs) that you have added in the service.
rcaspNotMatching.heading.2 = What to do next
rcaspNotMatching.list.1 = Check and update the value of the SendingEntityIN element in the MessageSpec section of your file to match the RCASP ID.
rcaspNotMatching.list.2 = Upload the updated file
rcaspNotMatching.heading.3 = If you have not yet added the RCASP in the service
rcaspNotMatching.p3.link.text = Add the RCASP in the service
rcaspNotMatching.p3.text = before you update your file.

